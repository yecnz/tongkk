{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Only the Tongkk settings WebView can control its window and Mac settings.",
  "windows": [
    "settings"
  ],
  "local": true,
  "remote": {
    "urls": [
      "https://tongkk.com",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "permissions": [
    "allow-settings-info",
    "allow-set-settings-autostart",
    "allow-close-settings",
    "allow-minimize-settings",
    "allow-drag-settings",
    "allow-resize-settings"
  ]
}
