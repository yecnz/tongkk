{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tongkk",
  "version": "0.1.0",
  "identifier": "com.tongkk.menubar",
  "build": {
    "frontendDist": "https://tongkk.com",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        },
        "appPosition": {
          "x": 170,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 430,
          "y": 170
        },
        "background": "dmg/background.tiff"
      }
    }
  }
}
