    "test:watch": "vitest",
    "preview": "vite preview",
    "test:workflow-db": "node scripts/test-workflow-schema.mjs",
    "test:flashcards-db": "node scripts/test-flashcards-db.mjs",
    "test:study-paths-db": "node scripts/test-study-paths-db.mjs",
    "menubar:dev": "tauri dev",
    "menubar:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tauri-apps/api": "^2.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
