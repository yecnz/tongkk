FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 학습 세션 전용 서버 키. 브라우저/VITE_ 환경변수에 넣지 않는다.
# supabase/migrations/202611220001_learning_sessions.sql 적용 후 설정한다.
SUPABASE_SECRET_KEY=
# 구형 프로젝트는 SUPABASE_SERVICE_ROLE_KEY를 대신 사용할 수 있다.
LEARNING_SESSION_MODEL=gpt-5.4-mini
# false면 새 세션 생성만 중단하고 기존 기록 조회·진행은 유지한다.
LEARNING_SESSION_ENABLED=true

# 개발용: Supabase 설정 없이 인증을 끄려면 true로 둔다. 운영에서는 절대 켜지 마라.
# (미설정 시 SUPABASE_URL/ANON_KEY가 비면 API가 503으로 막힌다 = fail-closed)
ALLOW_NO_AUTH=false

# 로그인 실패 5회 시 15분 잠금. 상태는 서버 로컬 SQLite에 저장한다.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
# LOGIN_ATTEMPTS_DB_PATH=/var/lib/tongkk/login_attempts.sqlite3
# Supabase IP 전달 허용 + 서버 키 + 신뢰 프록시 설정을 모두 완료한 뒤 true로 설정한다.
# 클라이언트가 보낸 X-Forwarded-For를 직접 신뢰하지 않는다. README 인증 설정 참고.
LOGIN_FORWARD_CLIENT_IP=false

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite-preview

GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Cloudflare tunnel friendly defaults. Raise these only if your backend is not
# behind a request timeout.
# auto: PDF·PPTX의 삽입 이미지를 비전 분석, always: 항상 분석, off: 비활성화
VISUAL_ANALYSIS_MODE=auto
# 시각 분석 모델: Gemini(기본) 또는 GPT. 그래프·도표 해석 가성비가 좋은 Gemini 2.5 Flash 권장.
VISUAL_ANALYSIS_MODEL=Gemini
VISUAL_ANALYSIS_GEMINI_MODEL=gemini-2.5-flash
VISUAL_ANALYSIS_OPENAI_MODEL=gpt-5.4-mini
VISUAL_ANALYSIS_MAX_ITEMS=12
VISUAL_ANALYSIS_BATCH_SIZE=4
# 이미지와 함께 보내는 본문 텍스트(맥락) 길이 상한.
VISUAL_CONTEXT_MAX_CHARS=1500
# AI 튜터에 첨부 가능한 이미지 수와 1장당 data URL 길이 상한(base64).
MAX_CHAT_IMAGES=3
MAX_CHAT_IMAGE_CHARS=8000000
# 단일 업로드 이미지의 최대 해상도(픽셀 수, 압축 폭탄 방어).
MAX_IMAGE_PIXELS=40000000
PDF_VISUAL_RENDER_DPI=90
PDF_VISUAL_TEXT_PAGE_CHARS=180

# AI usage: keep this SQLite file on a persistent volume; never store prompt/answer bodies.
# AI_USAGE_DB=/data/ai_usage.sqlite3
# Exact provider-returned model IDs. USD per million tokens, estimates only.
# AI_MODEL_PRICES_JSON={"your-model-id":{"input_per_million":0,"output_per_million":0}}

# Heavy document jobs share a per-worker limit. Container defaults to one worker.
CONVERSION_MAX_CONCURRENT=1
CONVERSION_MAX_WAITERS=4
CONVERSION_WAIT_SECONDS=10

# Set true on API and a separate python -m worker process after migration 009.
LEARNING_WORKER_ENABLED=false

# Google Calendar read-only integration. Register the frontend callback URL exactly.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=https://your-frontend/integrations/google-calendar/callback
# Generate once with Fernet.generate_key(); keep stable, secret, and backed up.
# INTEGRATION_ENCRYPTION_KEY=
