FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 개발용: Supabase 설정 없이 인증을 끄려면 true로 둔다. 운영에서는 절대 켜지 마라.
# (미설정 시 SUPABASE_URL/ANON_KEY가 비면 API가 503으로 막힌다 = fail-closed)
ALLOW_NO_AUTH=false

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite-preview

GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Cloudflare tunnel friendly defaults. Raise these only if your backend is not
# behind a request timeout.
# auto: 필요한 PDF 페이지/텍스트 부족 PPTX만 비전 분석, always: 항상 분석, off: 비활성화
VISUAL_ANALYSIS_MODE=auto
VISUAL_ANALYSIS_MAX_ITEMS=12
VISUAL_ANALYSIS_BATCH_SIZE=4
VISUAL_ANALYSIS_MIN_TEXT_CHARS=1200
PDF_VISUAL_RENDER_DPI=90
PDF_VISUAL_TEXT_PAGE_CHARS=180
